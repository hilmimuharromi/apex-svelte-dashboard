# ═══════════════════════════════════════════════════════════
#  Apex Svelte Dashboard — Environment Variables
#  Copy to .env and adjust values
# ═══════════════════════════════════════════════════════════

# ── Backend API (server-side only, NEVER exposed to client) ──
PRIVATE_API_BASE_URL=http://localhost:8080

# ── Public vars (safe to expose to browser) ──
PUBLIC_APP_NAME=Miromi Kids Care

# ── Server (adapter-node) ──
PORT=3000
HOST=0.0.0.0

# ── Auth cookie name (must match hooks.server.ts) ──
# AUTH_COOKIE_NAME=access_token

# ── Session / JWT ──
# AUTH_SECRET=change-me-to-a-long-random-string
